if(NOT DEFINED ENV{THEOS})
  message(FATAL_ERROR "Set THEOS to your Theos installation path before configuring.")
endif()
set(THEOS_ROOT "$ENV{THEOS}")
if(DEFINED ENV{IOS_SDK} AND NOT "$ENV{IOS_SDK}" STREQUAL "")
  set(IOS_SDK_PATH "$ENV{IOS_SDK}")
else()
  set(IOS_SDK_PATH "${THEOS_ROOT}/sdks/iPhoneOS16.5.sdk")
endif()
set(TOOLCHAIN "${THEOS_ROOT}/toolchain/linux/iphone/bin")
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_VERSION 15.0)
set(CMAKE_OSX_SYSROOT "${IOS_SDK_PATH}")
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_DEPLOYMENT_TARGET 15.0)
set(CMAKE_C_COMPILER "${TOOLCHAIN}/clang")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN}/clang++")
set(CMAKE_AR "${TOOLCHAIN}/llvm-ar")
set(CMAKE_RANLIB "${TOOLCHAIN}/llvm-ranlib")
set(CMAKE_STRIP "${TOOLCHAIN}/llvm-strip")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-target arm64-apple-ios15.0 -isysroot ${IOS_SDK_PATH}")
set(CMAKE_CXX_FLAGS_INIT "-target arm64-apple-ios15.0 -isysroot ${IOS_SDK_PATH} -stdlib=libc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-target arm64-apple-ios15.0 -isysroot ${IOS_SDK_PATH} -stdlib=libc++")
set(CMAKE_MACOSX_BUNDLE OFF CACHE BOOL "" FORCE)
