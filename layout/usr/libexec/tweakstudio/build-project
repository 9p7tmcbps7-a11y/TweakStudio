#!/var/jb/bin/bash
set -euo pipefail

PROJECT="${1:-}"
THEOS="${THEOS:-$HOME/theos}"
BIN="$HOME/Documents/TweakStudio/bin"
ALLEMANDE="$BIN/allemande"

if [[ -z "$PROJECT" || ! -d "$PROJECT" ]]; then
  echo "No project folder was supplied or the folder does not exist." >&2
  exit 2
fi
if [[ ! -f "$THEOS/makefiles/common.mk" ]]; then
  echo "Theos is not set up. Tap Set up Theos + iOS SDK in Settings > TweakStudio." >&2
  exit 3
fi
if [[ ! -x "$ALLEMANDE" ]]; then
  echo "The arm64e compatibility helper is missing. Run Set up Theos + iOS SDK first." >&2
  exit 4
fi

export THEOS
export PATH="/var/jb/usr/bin:/var/jb/bin:$THEOS/toolchain/iphone/bin:$PATH"
cd "$PROJECT"
make clean package

DEB="$(ls -t "$PROJECT"/packages/*.deb 2>/dev/null | head -n 1 || true)"
if [[ -z "$DEB" || ! -f "$DEB" ]]; then
  echo "Theos finished without producing a .deb in the project's packages folder." >&2
  exit 5
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/tweakstudio-build.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/root/DEBIAN"
dpkg-deb -x "$DEB" "$TMP/root"
dpkg-deb -e "$DEB" "$TMP/root/DEBIAN"
while IFS= read -r -d '' BINARY; do
  if /var/jb/usr/bin/otool -hv "$BINARY" 2>/dev/null | grep -q 'arm64e'; then
    "$ALLEMANDE" "$BINARY" "$TMP/converted"
    /var/jb/usr/bin/ldid -s "$TMP/converted"
    /var/jb/usr/bin/ldid -S "$TMP/converted"
    mv "$TMP/converted" "$BINARY"
  fi
done < <(find "$TMP/root" -type f -not -path '*/DEBIAN/*' -print0)
dpkg-deb -b --root-owner-group "$TMP/root" "$TMP/repacked.deb"
mv "$TMP/repacked.deb" "$DEB"
echo "Prepared rootless package: $DEB"
